{
    "name": "asignua/filament-translation-manager",
    "description": "Database-backed translation manager for Filament 5: edit, search, scan and quick-translate every __() string per locale, with a topbar language switcher. Successor of kenepa/translation-manager, built on spatie/laravel-translation-loader.",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "translations",
        "translation-manager",
        "localization",
        "i18n",
        "spatie",
        "filament-translation-manager"
    ],
    "homepage": "https://github.com/asignua/filament-translation-manager",
    "support": {
        "issues": "https://github.com/asignua/filament-translation-manager/issues",
        "source": "https://github.com/asignua/filament-translation-manager"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mykhailo Hladchenko",
            "email": "myhailo@hotmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-translation-loader": "^2.8",
        "symfony/finder": "^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Asignua\\FilamentTranslationManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asignua\\FilamentTranslationManager\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asignua\\FilamentTranslationManager\\TranslationManagerServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
